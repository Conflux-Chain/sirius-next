{
  "name": "sirius-next",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "turbo test -- --run",
    "test:coverage": "turbo test:coverage -- --run",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write $(git diff --cached --name-only --diff-filter=d -- '*.json' '*.js' '*.ts' '*.tsx' '*.md')",
    "prepare": "husky install",
    "test:consumers": "pnpm --filter @cfxjs/sirius-next-common test:consumer"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "@cfxjs/sirius-next-eslint-config": "workspace:*",
    "@cfxjs/sirius-next-typescript-config": "workspace:*",
    "@changesets/cli": "^2.27.9",
    "husky": "^9.0.11",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "tsup": "6.6.0",
    "vitest": "3.2.6",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@9.5.0",
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "8.23.0",
      "styled-jsx@3.4.7>loader-utils": "1.4.2",
      "tsup@6.6.0>postcss-load-config": "4.0.2"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{json,js,ts,tsx,md}": [
      "pnpm run format"
    ]
  }
}
